{
  "name": "nestchat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,cyan \"npm run dev --workspace @nestchat/api\" \"npm run dev --workspace @nestchat/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate dev --schema apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "typescript": "5.9.3",
    "typescript-eslint": "latest"
  },
  "allowScripts": {
    "@prisma/client@6.16.2": true,
    "@prisma/engines@6.16.2": true,
    "prisma@6.16.2": true,
    "argon2@0.45.1": true
  }
}
